["البطاقة التنفيذية","نيلي كلاسيكي",3,"#312e81","#4338ca","#fafaff","#1e1b4b","#eef2ff","#4338ca","#fff"],
["الهندسي الأنيق","أحمر ياقوتي",2,"#be123c","#881337","#f1f5f9","#1e293b","#fff","#64748b","#fff"]];
const F=[["الاسم بالكامل","name","user"],["السن","age","hourglass-half"],["الديانة","religion","star-and-crescent"],["الوظيفة / الدراسة","job","graduation-cap"],["محل الإقامة","address","location-dot"],["رقم التواصل","phone","phone"],["البريد الإلكتروني","email","envelope"]];
const IN=[["name","الاسم بالكامل","user","مثال: أحمد محمد علي",1],["age","السن","calendar-days","23 عاماً"],["religion","الديانة","moon","مسلم"],["job","الوظيفة أو الدراسة","graduation-cap","طالب في كلية ...",1],["address","محل الإقامة","location-dot","القاهرة - مدينة نصر",1],["phone","رقم التواصل (اختياري)","phone","01xxxxxxxxx"],["email","البريد (اختياري)","envelope","name@mail.com"],["bio","نبذة مختصرة (اختياري)","quote-right","أسعى لتطوير مهاراتي...",1]];
const DEF={name:"مجدي السيد عبد المنعم عبده",age:"23 عاماً",religion:"مسلم",job:"طالب في الفرقة الخامسة — كلية الطب البيطري",address:"محافظة الدقهلية — مركز ومدينة أجا",bio:"بيانات شخصية وأكاديمية موثقة ومرتبة بصيغة رسمية."};
let cur=1,photo="",custom="";

$('form').innerHTML=IN.map(f=>`<div class="fg${f[4]?' full':''}"><label>${f[1]}</label><div class="iw"><input class="fc" id="in-${f[0]}" placeholder="${f[3]}"><i class="fa-solid fa-${f[2]}"></i></div></div>`).join('');
IN.forEach(f=>$('in-'+f[0]).oninput=()=>{render();save()});

function shade(h,p){const n=parseInt(h.slice(1),16);const c=k=>Math.max(0,Math.min(255,Math.round(((n>>k)&255)*(1+p))));return'#'+((1<<24)|(c(16)<<16)|(c(8)<<8)|c(0)).toString(16).slice(1)}
const get=()=>{const d={};IN.forEach(f=>d[f[0]]=$('in-'+f[0]).value.trim()||DEF[f[0]]||"");return d};
const save=()=>{try{const o={};IN.forEach(f=>o[f[0]]=$('in-'+f[0]).value);localStorage.setItem('cvs',JSON.stringify(o))}catch(e){}};
const R=(f,v,i,c='')=>`<div class="row ${c}" style="--i:${i}"><i class="fa-solid fa-${f[2]}"></i><div><small>${f[0]}</small><b>${esc(v)}</b></div></div>`;

function render(anim){
  const d=get(),T=TPL[cur-1],L=T[2],p=$('paper');
  let a=custom||T[3],b=custom?shade(custom,-.3):T[4];
  const rows=F.slice(1).filter(f=>d[f[1]]);
  const av=photo?`<img src="${photo}">`:esc(d.name.charAt(0)||"م");
  const bio=`<div class="bio" style="--i:9">${esc(d.bio)}</div>`;
  const all=rows.map((f,i)=>R(f,d[f[1]],i)).join('');
  let h='';
  if(L==1)h=`<div class="hd"><div class="av">${av}</div><div><span class="tag"><i class="fa-solid fa-id-card"></i> بطاقة تعريفية</span><h1>${esc(d.name)}</h1><p>${esc(d.job)}</p></div></div><div class="stt">البيانات الشخصية</div><div class="g2">${all}</div>${bio}`;
  if(L==2){const side=rows.filter(f=>f[1]!='job').map((f,i)=>R(f,d[f[1]],i)).join('');
    h=`<aside><div class="av">${av}</div>${side}</aside><section><h1>${esc(d.name)}</h1><div class="role">${esc(d.job)}</div>${bio}${R(F[0],d.name,1)}${R(F[3],d.job,2)}</section>`}
  if(L==3)h=`<div class="frame"><div class="av">${av}</div><h1>${esc(d.name)}</h1><div class="role">${esc(d.job)}</div><div class="line"></div><div class="col">${all}</div>${bio}</div>`;
  if(L==4)h=`<div class="hero"><div class="av">${av}</div><div><h1>${esc(d.name)}</h1><p>${esc(d.job)}</p></div></div><div class="g2">${rows.map((f,i)=>R(f,d[f[1]],i,['job','address','email'].includes(f[1])?'wide':'')).join('')}<div class="bio wide" style="--i:9">${esc(d.bio)}</div></div>`;
  if(L==5)h=`<div class="bar"></div><div class="top"><div><h1>${esc(d.name)}</h1><div class="role">${esc(d.job)}</div></div><div class="av">${av}</div></div>${rows.map((f,i)=>`<div class="tr r" style="--i:${i}"><span>${f[0]}</span><b>${esc(d[f[1]])}</b></div>`).join('')}<div class="tr" style="--i:9"><span>نبذة</span><b style="font-weight:600;color:#374151">${esc(d.bio)}</b></div>`;
  p.className=`paper l${L}`+(anim?' anim pop':'');
  p.setAttribute('style',`--a:${a};--b:${b};--bg:${T[5]};--ink:${T[6]};--card:${T[7]};--mut:${T[8]};--hd:${T[9]}`);
  p.innerHTML=h+`<div class="pf">تم إنشاء هذا المستند عبر CV Studio</div>`;
  $('tlabel').textContent=`القالب ${cur}: ${T[0]}`;
}
function drawTpl(){$('tpls').innerHTML=TPL.map((t,i)=>`<div class="tc${i+1==cur?' on':''}" onclick="pick(${i+1})"><div class="dot" style="background:linear-gradient(135deg,${t[3]},${t[4]})"></div><div><h4>${i+1}. ${t[0]}</h4><span>${t[1]}</span></div></div>`).join('')}
function pick(i){cur=i;custom="";drawTpl();render(true)}

/* ---------- Scale to fit ---------- */
function fit(){const s=Math.min(1,($('stage').clientWidth-4)/794);$('paper').style.transform=`scale(${s})`;$('stage').style.height=(1122*s)+'px'}
addEventListener('resize',fit);

/* ---------- Photo / color / demo / reset ---------- */
$('photo').onchange=e=>{const f=e.target.files[0];if(!f)return;const r=new FileReader();r.onload=()=>{photo=r.result;render();toast('تمت إضافة الصورة ✓')};r.readAsDataURL(f)};
$('color').oninput=e=>{custom=e.target.value;render()};
$('demo').onclick=()=>{Object.keys(DEF).forEach(k=>$('in-'+k).value=DEF[k]);$('in-bio').value="طالب بالفرقة الخامسة بكلية الطب البيطري، مهتم بالتطوير المستمر والعمل الميداني والبحثي.";$('in-phone').value="01012345678";render(true);save();toast('تمت تعبئة بيانات تجريبية')};
$('reset').onclick=()=>{IN.forEach(f=>$('in-'+f[0]).value="");photo="";custom="";render();save();toast('تمت إعادة الضبط')};

/* ---------- PDF: download + WhatsApp share ---------- */
function toast(m){const t=$('toast');t.textContent=m;t.classList.add('on');clearTimeout(t._t);t._t=setTimeout(()=>t.classList.remove('on'),2600)}
async function makePdf(){
  const c=$('paper').cloneNode(true);c.classList.add('exp');c.style.transform='none';c.style.height='1120px';
  const h=document.createElement('div');h.style.cssText='position:fixed;left:-9999px;top:0';h.appendChild(c);document.body.appendChild(h);
  try{await document.fonts.ready;return await html2pdf().set({margin:0,image:{type:'jpeg',quality:.98},html2canvas:{scale:2,useCORS:true,scrollX:0,scrollY:0},jsPDF:{unit:'px',format:[794,1122],orientation:'portrait',hotfixes:['px_scaling']}}).from(c).outputPdf('blob')}
  finally{h.remove()}
}
const fname=()=>`${($('in-name').value.trim()||'السيرة_الذاتية').replace(/[\\/:*?"<>|]/g,'')}_قالب_${cur}.pdf`;
async function run(btn,fn){const o=btn.innerHTML;btn.disabled=true;btn.innerHTML='<i class="fa-solid fa-spinner fa-spin"></i> لحظة...';try{await fn()}catch(e){console.error(e);toast('حصلت مشكلة، جرّب تاني')}btn.innerHTML=o;btn.disabled=false}
function saveBlob(b,n){const u=URL.createObjectURL(b),a=document.createElement('a');a.href=u;a.download=n;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(u),4000)}
$('dl').onclick=()=>run($('dl'),async()=>{saveBlob(await makePdf(),fname());toast('تم تحميل الملف على جهازك ✓')});
$('sh').onclick=()=>run($('sh'),async()=>{
  const b=await makePdf(),f=new File([b],fname(),{type:'application/pdf'});
  if(navigator.canShare&&navigator.canShare({files:[f]})){try{await navigator.share({files:[f],title:'بطاقة بياناتي',text:'ملف PDF من CV Studio'});return}catch(e){if(e.name==='AbortError')return}}
  saveBlob(b,fname());toast('تم تحميل الملف — ابعته من الواتساب');
  setTimeout(()=>window.open('https://wa.me/?text='+encodeURIComponent('بعتلك ملف بياناتي (PDF) — اتعمل من CV Studio'),'_blank'),900);
});

/* ---------- Init ---------- */
try{const o=JSON.parse(localStorage.getItem('cvs')||'{}');IN.forEach(f=>{if(o[f[0]])$('in-'+f[0]).value=o[f[0]]})}catch(e){}
drawTpl();render(true);fit();
</script>
</body>
</html>