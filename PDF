/* ---------- Code rain (background + loader) ---------- */
function rain(cv,alpha,fade){
  const x=cv.getContext('2d'),T="{}[]()<>/=;:+*01$#&|=>".split("");let W,H,cols,y;const S=16;
  const size=()=>{W=cv.width=innerWidth;H=cv.height=innerHeight;cols=Math.ceil(W/S);y=Array.from({length:cols},()=>Math.random()*-60)};
