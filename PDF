<style>
:root{--bg:#070b14;--panel:rgba(16,23,40,.8);--bd:rgba(255,255,255,.1);--ac:#3b82f6;--ac2:#8b5cf6;--mut:#94a3b8}
*{box-sizing:border-box;margin:0;padding:0;font-family:'Cairo',sans-serif}
body{background:var(--bg);color:#f8fafc;min-height:100vh;overflow-x:hidden;padding-bottom:92px}
#rain{position:fixed;inset:0;z-index:-2;width:100%;height:100%}
.orb{position:fixed;z-index:-1;border-radius:50%;filter:blur(90px);opacity:.3;animation:fl 12s infinite alternate ease-in-out;pointer-events:none}
.o1{width:320px;height:320px;background:#2563eb;top:-60px;right:8%}.o2{width:280px;height:280px;background:#7c3aed;bottom:40px;left:8%;animation-delay:-5s}
@keyframes fl{to{transform:translate(-30px,40px) scale(1.15)}}

/* ===== Loader ===== */
#loader{position:fixed;inset:0;z-index:999;background:radial-gradient(circle at 50% 40%,#0c1424,#04060c 70%);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:22px;transition:opacity .8s,transform .8s,visibility .8s;cursor:pointer;overflow:hidden}
#loader.out{opacity:0;transform:scale(1.08);visibility:hidden}
#lcode{position:absolute;inset:0;width:100%;height:100%;opacity:.55}
.lname{position:relative;font-family:'Playfair Display',serif;font-weight:700;font-size:clamp(2rem,9vw,4.6rem);letter-spacing:.14em;direction:ltr;text-align:center;line-height:1.1;z-index:2}
.ch{display:inline-block;opacity:0;background:linear-gradient(180deg,#fff,#93c5fd);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;transform:translateY(-140px);filter:blur(8px);animation:drop .9s cubic-bezier(.2,.9,.3,1.15) forwards;animation-delay:var(--d)}
.ch.sp{width:.4em}
@keyframes drop{60%{opacity:1}to{opacity:1;transform:none;filter:none}}
.lname::before,.lname::after{content:attr(data-t);position:absolute;inset:0;opacity:0;direction:ltr}
.lname.gl::before{color:#22d3ee;animation:g1 .7s steps(2) 2;opacity:.8}
.lname.gl::after{color:#f472b6;animation:g2 .7s steps(2) 2;opacity:.8}
@keyframes g1{0%{clip-path:inset(10% 0 70% 0);transform:translate(-6px,0)}25%{clip-path:inset(55% 0 20% 0);transform:translate(6px,0)}50%{clip-path:inset(30% 0 45% 0);transform:translate(-4px,0)}75%{clip-path:inset(75% 0 5% 0);transform:translate(4px,0)}100%{clip-path:inset(0);opacity:0}}
@keyframes g2{0%{clip-path:inset(60% 0 10% 0);transform:translate(6px,0)}25%{clip-path:inset(15% 0 65% 0);transform:translate(-6px,0)}50%{clip-path:inset(45% 0 30% 0);transform:translate(4px,0)}75%{clip-path:inset(5% 0 80% 0);transform:translate(-4px,0)}100%{clip-path:inset(0);opacity:0}}
.lline{width:0;height:2px;background:linear-gradient(90deg,transparent,#60a5fa,#c084fc,transparent);animation:ln 1.2s ease 1.5s forwards;z-index:2}
@keyframes ln{to{width:min(360px,70vw)}}
.lsub{font-size:clamp(1rem,3.6vw,1.35rem);font-weight:700;color:#cbd5e1;opacity:0;animation:fi .9s ease 1.9s forwards;z-index:2;text-align:center;padding:0 16px}
.lsub b{color:#60a5fa}
@keyframes fi{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}
.lbar{width:min(260px,60vw);height:3px;background:rgba(255,255,255,.1);border-radius:9px;overflow:hidden;z-index:2}
.lbar i{display:block;height:100%;width:0;background:linear-gradient(90deg,#3b82f6,#a78bfa);animation:bar 3.4s ease-in-out forwards}
@keyframes bar{to{width:100%}}

/* ===== Header ===== */
header{padding:14px 4%;display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;border-bottom:1px solid var(--bd);backdrop-filter:blur(14px);background:rgba(7,11,20,.72);position:sticky;top:0;z-index:100}
.logo{display:flex;align-items:center;gap:10px;font-size:1.3rem;font-weight:900;background:linear-gradient(135deg,#60a5fa,#c084fc);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
.logo i{-webkit-text-fill-color:#60a5fa}
.acts{display:flex;gap:8px;flex-wrap:wrap}
.btn{padding:10px 16px;border-radius:12px;border:0;font-weight:800;font-size:.9rem;cursor:pointer;display:inline-flex;align-items:center;gap:8px;color:#fff;transition:.25s;text-decoration:none}
.btn:hover{transform:translateY(-2px)}.btn:disabled{opacity:.7;cursor:wait}
.pri{background:linear-gradient(135deg,var(--ac),var(--ac2));box-shadow:0 4px 20px rgba(59,130,246,.45)}
.wa{background:linear-gradient(135deg,#16a34a,#22c55e);box-shadow:0 4px 18px rgba(34,197,94,.35)}
.sec{background:rgba(255,255,255,.08);border:1px solid var(--bd)}

/* ===== Layout ===== */
.main{max-width:1440px;margin:24px auto;padding:0 20px;display:grid;grid-template-columns:420px 1fr;gap:28px;align-items:start}
.panel{background:var(--panel);border:1px solid var(--bd);border-radius:20px;padding:22px;backdrop-filter:blur(16px);box-shadow:0 20px 50px rgba(0,0,0,.4);animation:up .7s ease-out}
@keyframes up{from{opacity:0;transform:translateY(24px)}}
.st{font-size:1.1rem;font-weight:800;margin:0 0 14px;display:flex;align-items:center;gap:10px;color:#93c5fd}
.fgrid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.full{grid-column:span 2}
.fg label{display:block;font-size:.85rem;font-weight:700;color:#cbd5e1;margin-bottom:5px}
.iw{position:relative}.iw i{position:absolute;right:13px;top:50%;transform:translateY(-50%);color:#64748b;transition:.3s}
.iw:focus-within i{color:var(--ac)}
.fc{width:100%;padding:11px 38px 11px 12px;background:rgba(15,23,42,.75);border:1px solid rgba(255,255,255,.12);border-radius:12px;color:#fff;font-size:.92rem;transition:.25s}
.fc:focus{outline:0;border-color:var(--ac);box-shadow:0 0 0 3px rgba(59,130,246,.25)}
.tools{display:flex;gap:10px;margin-top:14px;flex-wrap:wrap}
.tools .btn{flex:1;justify-content:center;font-size:.82rem;padding:10px 8px}
input[type=color]{width:100%;height:100%;border:0;background:none;cursor:pointer;opacity:0;position:absolute;inset:0}
.cbtn{position:relative;overflow:hidden}
.div{height:1px;background:var(--bd);margin:20px 0}
.tgrid{display:grid;grid-template-columns:1fr 1fr;gap:10px;max-height:300px;overflow-y:auto;padding:3px}
.tc{background:rgba(15,23,42,.65);border:2px solid transparent;border-radius:12px;padding:9px 11px;cursor:pointer;display:flex;align-items:center;gap:9px;transition:.25s}
.tc:hover{transform:translateY(-2px);background:rgba(30,41,59,.9)}
.tc.on{border-color:#60a5fa;background:rgba(59,130,246,.15);box-shadow:0 0 15px rgba(59,130,246,.25)}
.dot{width:26px;height:26px;border-radius:8px;flex-shrink:0;border:1px solid rgba(255,255,255,.25)}
.tc h4{font-size:.8rem;font-weight:800}.tc span{font-size:.68rem;color:var(--mut)}
.prev{display:flex;flex-direction:column;align-items:center;min-width:0;animation:up .85s ease-out}
.tb{width:100%;max-width:794px;display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;padding:10px 16px;background:var(--panel);border:1px solid var(--bd);border-radius:14px;font-size:.85rem}
.live{display:flex;align-items:center;gap:8px;color:#34d399;font-weight:800}
.live::before{content:"";width:9px;height:9px;border-radius:50%;background:#10b981;animation:pu 1.5s infinite}
@keyframes pu{0%{box-shadow:0 0 0 0 rgba(16,185,129,.7)}70%,100%{box-shadow:0 0 0 8px transparent}}
.stage{width:100%;display:flex;justify-content:center;overflow:hidden}

/* ===== Paper ===== */
.paper{width:794px;height:1122px;flex-shrink:0;position:relative;overflow:hidden;direction:rtl;background:var(--bg);color:var(--ink);box-shadow:0 25px 60px rgba(0,0,0,.6);transform-origin:top center}
.paper *{font-family:'Cairo',sans-serif}
.paper{--bg:#fff}
.paper::before{content:"";position:absolute;width:340px;height:340px;border-radius:50%;background:var(--b);opacity:.07;left:-110px;bottom:-110px}
.paper::after{content:"";position:absolute;width:200px;height:200px;border-radius:50%;border:30px solid var(--a);opacity:.05;right:-60px;bottom:120px}
.paper h1{font-size:2.15rem;font-weight:900;line-height:1.3}
.av{width:104px;height:104px;border-radius:50%;background:linear-gradient(135deg,var(--a),var(--b));display:grid;place-items:center;font-size:2.6rem;font-weight:900;color:#fff;overflow:hidden;border:4px solid rgba(255,255,255,.4);flex-shrink:0}
.av img{width:100%;height:100%;object-fit:cover}
.row{display:flex;gap:13px;align-items:center;padding:12px 15px;background:var(--card);border-radius:14px;border:1px solid rgba(128,128,128,.16);position:relative;z-index:1}
.row i{width:40px;height:40px;border-radius:12px;background:linear-gradient(135deg,var(--a),var(--b));color:#fff;display:grid;place-items:center;flex-shrink:0}
.row small{display:block;color:var(--mut);font-weight:700;font-size:.76rem}.row b{font-size:1rem;font-weight:800;word-break:break-word}
.bio{padding:18px 20px;background:var(--card);border-radius:14px;border-right:5px solid var(--b);line-height:1.9;color:var(--mut);font-weight:600;position:relative;z-index:1}
.pf{position:absolute;bottom:14px;left:0;right:0;text-align:center;font-size:.72rem;opacity:.5;z-index:1}
.g2{display:grid;grid-template-columns:1fr 1fr;gap:14px}.wide{grid-column:span 2}
.paper.anim .row,.paper.anim .bio{animation:ri .55s both;animation-delay:calc(var(--i,0)*70ms)}
@keyframes ri{from{opacity:0;transform:translateY(16px)}}
.paper.pop{animation:pp .5s cubic-bezier(.16,1,.3,1)}
@keyframes pp{from{opacity:.3;filter:blur(4px)}}
.exp *,.exp{animation:none!important}
/* L1 */
.l1{padding:44px}
.l1 .hd{display:flex;gap:24px;align-items:center;background:linear-gradient(135deg,var(--a),var(--b));color:var(--hd);padding:38px;border-radius:24px;margin-bottom:30px;box-shadow:0 14px 30px rgba(0,0,0,.2);position:relative;z-index:1}
.l1 .hd p{opacity:.92;margin-top:6px;font-size:1.1rem}
.tag{display:inline-block;background:rgba(255,255,255,.2);padding:3px 14px;border-radius:20px;font-size:.8rem;margin-bottom:8px}
.stt{font-size:1.2rem;font-weight:800;color:var(--a);border-right:5px solid var(--b);padding-right:12px;margin-bottom:16px;position:relative;z-index:1}
.l1 .bio{margin-top:24px}
/* L2 */
.l2{display:grid;grid-template-columns:262px 1fr}
.l2 aside{background:linear-gradient(180deg,var(--a),var(--b));color:var(--hd);padding:46px 22px;text-align:center}
.l2 aside .av{margin:0 auto 22px;width:120px;height:120px}
.l2 aside .row{background:rgba(255,255,255,.13);border:0;margin-bottom:10px;text-align:right}
.l2 aside .row small{color:rgba(255,255,255,.72)}.l2 aside .row i{background:rgba(255,255,255,.22)}
.l2 section{padding:56px 38px;display:flex;flex-direction:column;gap:14px}
.l2 .role{color:var(--a);font-weight:800;font-size:1.15rem;margin:-4px 0 12px}.l2 .pf{display:none}
/* L3 */
.l3{padding:34px}
.frame{height:100%;border:7px double var(--a);padding:38px 40px;text-align:center;position:relative;z-index:1}
.frame .av{margin:0 auto 16px}.frame h1{color:var(--b)}.frame .role{opacity:.85;margin-top:6px;font-size:1.1rem}
.line{height:2px;background:linear-gradient(90deg,transparent,var(--a),transparent);margin:24px 0}
.frame .col{display:flex;flex-direction:column;gap:11px;text-align:right}.frame .bio{margin-top:20px;border:0;border-top:2px solid var(--a);text-align:center}
/* L4 */
.l4 .hero{background:linear-gradient(135deg,var(--a),var(--b));color:#fff;padding:52px 44px 120px;clip-path:polygon(0 0,100% 0,100% 82%,0 100%);display:flex;gap:22px;align-items:center}
.l4 .hero p{font-size:1.15rem;opacity:.92;margin-top:6px}
.l4 .g2{padding:0 44px;margin-top:-52px;position:relative;z-index:1}
/* L5 */
.l5{padding:66px 56px}
.bar{width:72px;height:7px;background:var(--a);margin-bottom:24px}
.l5 .top{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:40px}
.l5 .role{color:var(--mut);font-size:1.15rem;font-weight:700;margin-top:4px}
.l5 .av{border-color:#e5e7eb}
.tr{display:flex;padding:20px 6px;border-top:1px solid #e5e7eb;font-size:1.05rem;position:relative;z-index:1}.tr:last-of-type{border-bottom:1px solid #e5e7eb}
.tr span{width:34%;color:var(--mut);font-weight:700}.tr b{font-weight:800;flex:1}

/* ===== Footer ===== */
.dock{position:fixed;bottom:0;left:0;right:0;z-index:200;display:flex;justify-content:center;gap:14px;align-items:center;flex-wrap:wrap;padding:10px 14px calc(10px + env(safe-area-inset-bottom,0px));background:rgba(5,8,16,.88);backdrop-filter:blur(16px);border-top:1px solid rgba(96,165,250,.3);box-shadow:0 -10px 30px rgba(37,99,235,.15)}
.by{font-weight:700;font-size:.95rem;color:#cbd5e1;display:flex;align-items:center;gap:7px}
.by em{font-style:normal;font-family:'Playfair Display',serif;font-size:1.25rem;font-weight:700;background:linear-gradient(90deg,#38bdf8,#2563eb,#38bdf8);background-size:200% auto;-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;animation:sh 3s linear infinite}
@keyframes sh{to{background-position:200% center}}
.vf{color:#1d9bf0;font-size:1.1rem;filter:drop-shadow(0 0 6px rgba(29,155,240,.7))}
.toast{position:fixed;bottom:100px;left:50%;transform:translate(-50%,30px);background:#0f172a;border:1px solid var(--bd);padding:11px 20px;border-radius:12px;font-weight:700;opacity:0;transition:.4s;z-index:300;pointer-events:none;max-width:90vw;text-align:center}
.toast.on{opacity:1;transform:translate(-50%,0)}
@media(max-width:1150px){.main{grid-template-columns:1fr;padding:0 12px}}
@media(max-width:560px){.logo span{display:none}.acts{width:100%}.acts .btn{flex:1;justify-content:center;padding:10px 6px;font-size:.82rem}}
@media(prefers-reduced-motion:reduce){*{animation-duration:.01s!important}}
</style>
